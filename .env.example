# Copy to `.env` and adjust. Never commit the real .env.

# --- app ---
DEBUG=true

# --- database ---
# Supabase managed Postgres. Use the SESSION POOLER host (IPv4); the direct
# host db.<project-ref>.supabase.co is IPv6-only. Two gotchas:
#   1. the user is postgres.<project-ref>, not plain postgres
#   2. SQLAlchemy needs the +psycopg driver tag that Supabase's copy button omits
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Local Postgres (docker compose up -d)
DATABASE_URL=postgresql+psycopg://alluviai:alluviai123@localhost:5432/alluviai
# Or, for a zero-dependency run with no Docker:
# DATABASE_URL=sqlite+aiosqlite:///./alluviai.db

# --- auth ---
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-in-production
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- social sign-in ---
# Comma-separated OAuth client IDs the mobile app signs in with (Google
# issues one per platform). The matching endpoint answers 501 until set.
# GOOGLE_CLIENT_IDS=1234567890-abc.apps.googleusercontent.com
# APPLE_BUNDLE_IDS=

# --- vision provider ---
# stub   = deterministic offline analyser, no key, no cost (default)
# claude = Anthropic vision (needs ANTHROPIC_API_KEY below)
VISION_PROVIDER=stub
# VISION_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-...
VISION_MODEL=claude-opus-5
# Effort trades depth against latency and cost: low | medium | high | xhigh | max
VISION_EFFORT=medium

# --- email ---
# console = written to the server log, no key, no network (default)
# resend  = real delivery (needs RESEND_API_KEY below)
EMAIL_PROVIDER=console
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_...
# Must be on a domain verified in the Resend dashboard. The default sandbox
# sender below needs no setup but only delivers to your own account address.
EMAIL_FROM=Alluvi <onboarding@resend.dev>
PASSWORD_RESET_URL=https://alluvi.dev/reset-password

# --- push notifications ---
# console = written to the server log, no key, no network (default)
# fcm     = real delivery via Firebase Cloud Messaging
PUSH_PROVIDER=console
# PUSH_PROVIDER=fcm
# Firebase console → Project settings → Service accounts → Generate new
# private key. Keep the JSON outside the repo.
# FIREBASE_CREDENTIALS=./secrets/firebase-service-account.json
# The in-process meal-reminder loop. Fires at each user's local slot times.
REMINDERS_ENABLED=true

# --- storage ---
MEDIA_ROOT=./media
PHOTO_MAX_EDGE_PX=1568
