# Copy to `.env` and adjust. Never commit the real .env.

# --- app ---
DEBUG=true

# --- database ---
# Postgres (docker compose up -d)
DATABASE_URL=postgresql+psycopg://alluviai:alluviai123@localhost:5432/alluviai
# Or, for a zero-dependency run with no Docker:
# DATABASE_URL=sqlite+aiosqlite:///./alluviai.db

# --- auth ---
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-in-production
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- vision provider ---
# stub   = deterministic offline analyser, no key, no cost (default)
# claude = Anthropic vision (needs ANTHROPIC_API_KEY below)
VISION_PROVIDER=stub
# VISION_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-...
VISION_MODEL=claude-opus-5
# Effort trades depth against latency and cost: low | medium | high | xhigh | max
VISION_EFFORT=medium

# --- email ---
# console = written to the server log, no key, no network (default)
# resend  = real delivery (needs RESEND_API_KEY below)
EMAIL_PROVIDER=console
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_...
# Must be on a domain verified in the Resend dashboard. The default sandbox
# sender below needs no setup but only delivers to your own account address.
EMAIL_FROM=Alluvi <onboarding@resend.dev>
PASSWORD_RESET_URL=https://alluvi.dev/reset-password

# --- storage ---
MEDIA_ROOT=./media
PHOTO_MAX_EDGE_PX=1568
